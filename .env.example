POSTGRES_DB=land_valuation
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/land_valuation
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_ENV=development
APP_NAME=Land Valuation API
APP_HOST=0.0.0.0
APP_PORT=8000
API_PORT=8000
DOCS_ENABLED=true
LOG_LEVEL=INFO
# Enable only for an isolated competition/demo deployment with fixed demo accounts.
DEMO_QUICK_LOGIN_ENABLED=false
# Maximum Office document size accepted by inline preview (10 MiB by default).
DOCUMENT_PREVIEW_MAX_BYTES=10485760

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=land-valuation
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRY_SECONDS=900

# Knowledge AI safe default; codex_cli is explicitly development/test only.
KNOWLEDGE_ANSWER_PROVIDER=evidence_only
KNOWLEDGE_AI_MAX_SOURCE_CHARACTERS=60000
# Per-request limits for on-demand MinIO knowledge extraction.
KNOWLEDGE_RUNTIME_MAX_OBJECTS=100
KNOWLEDGE_RUNTIME_MAX_OBJECT_BYTES=10485760
KNOWLEDGE_RUNTIME_MAX_TOTAL_BYTES=52428800
KNOWLEDGE_RUNTIME_MAX_TOTAL_CHARACTERS=200000
CODEX_CLI_COMMAND=codex
# CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=180
BEDROCK_TIMEOUT_SECONDS=60
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PDF text extraction. AUTO uses local text first, then Textract when configured.
DOCUMENT_EXTRACTION_PROVIDER=auto
LOCAL_OCR_LANGUAGES=chi_tra+eng
LOCAL_OCR_DPI=300
LOCAL_OCR_PSM=1
LOCAL_OCR_TIMEOUT_SECONDS=120
LOCAL_OCR_MAX_PAGES=50
TEXTRACT_REGION=
TEXTRACT_S3_BUCKET=
TEXTRACT_S3_PREFIX=land-valuation-textract
TEXTRACT_TIMEOUT_SECONDS=120
TEXTRACT_POLL_INTERVAL_SECONDS=1

# Leave AWS credentials empty in Git. Set them only in the local .env or runtime role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# F03 AI assistant. mock is the safe default. For local Ollama testing set
# AI_PROVIDER=ollama. Native FastAPI uses OLLAMA_BASE_URL; Docker Compose maps
# OLLAMA_DOCKER_BASE_URL into the API container instead.
AI_PROVIDER=mock
AI_PROMPT_VERSION=f03-v1
AI_FIELD_ANALYSIS_PROMPT_VERSION=field-analysis-v1
AI_CODEX_IMPORT_PROMPT_VERSION=codex-field-analysis-v1
AI_RULE_EXTRACTION_PROMPT_VERSION=rule-pack-extraction-v1
AI_FIELD_ANALYSIS_MAX_CHARS=40000
AI_FIELD_ANALYSIS_MAX_CANDIDATES=30
AI_TIMEOUT_SECONDS=30
AI_MAX_TOOL_ROUNDS=5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_TIMEOUT_SECONDS=120
BEDROCK_REGION=
BEDROCK_MODEL_ID=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
