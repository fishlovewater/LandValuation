POSTGRES_DB=land_valuation
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/land_valuation
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_ENV=development
APP_NAME=Land Valuation API
APP_HOST=0.0.0.0
APP_PORT=8000
API_PORT=8000
DOCS_ENABLED=true
LOG_LEVEL=INFO
# Enable only for an isolated competition/demo deployment with fixed demo accounts.
DEMO_QUICK_LOGIN_ENABLED=false
# Password reset tokens are short-lived. Raw tokens are never stored.
PASSWORD_RESET_TOKEN_MINUTES=30
# Development/demo only: return a reset token in the API response for local testing.
PASSWORD_RESET_DEBUG_TOKEN_ENABLED=false
# Public frontend URL used in password setup/reset emails.
PUBLIC_APP_URL=http://127.0.0.1:5173
# Required outside development/test. Leave blank for local Demo unless you want to test email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
# Maximum Office document size accepted by inline preview (10 MiB by default).
DOCUMENT_PREVIEW_MAX_BYTES=10485760

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=land-valuation
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRY_SECONDS=900
# Object storage defaults to MinIO.  Set aws_s3 to use an existing AWS S3
# bucket through AWS_PROFILE or the runtime role.  AWS_S3_BUCKET falls back to
# TEXTRACT_S3_BUCKET when left blank.
OBJECT_STORAGE_PROVIDER=minio
AWS_S3_BUCKET=
AWS_S3_REGION=
# Optional. When both keys are set, formal report pages 1-3 preserve the exact
# official blank PDF background and overlay only calibrated values from the
# matching manifest. Leave both blank until the authority supplies the final
# blank template and its coordinates are verified.
OFFICIAL_REPORT_BLANK_TEMPLATE_OBJECT_KEY=
OFFICIAL_REPORT_BLANK_TEMPLATE_MANIFEST_OBJECT_KEY=

# Knowledge answers use only authorized source documents. Bedrock is configured
# for the AWS demo; evidence_only remains available for offline/local testing.
KNOWLEDGE_ANSWER_PROVIDER=bedrock
KNOWLEDGE_AI_MAX_SOURCE_CHARACTERS=60000
# Per-request limits for on-demand MinIO knowledge extraction.
KNOWLEDGE_RUNTIME_MAX_OBJECTS=100
KNOWLEDGE_RUNTIME_MAX_OBJECT_BYTES=10485760
KNOWLEDGE_RUNTIME_MAX_TOTAL_BYTES=52428800
KNOWLEDGE_RUNTIME_MAX_TOTAL_CHARACTERS=200000
CODEX_CLI_COMMAND=codex
# CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=180
BEDROCK_TIMEOUT_SECONDS=60
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PDF extraction. With Textract configured, AUTO uses Textract first and local PDF/OCR as fallback.
DOCUMENT_EXTRACTION_PROVIDER=auto
LOCAL_OCR_LANGUAGES=chi_tra+eng
LOCAL_OCR_DPI=300
LOCAL_OCR_PSM=1
LOCAL_OCR_TIMEOUT_SECONDS=120
LOCAL_OCR_MAX_PAGES=50
TEXTRACT_REGION=us-east-1
TEXTRACT_S3_BUCKET=land-valuation-textract-spacey
TEXTRACT_S3_PREFIX=land-valuation-textract
TEXTRACT_TIMEOUT_SECONDS=120
TEXTRACT_POLL_INTERVAL_SECONDS=1

# Leave AWS credentials empty in Git. Set them only in the local .env or runtime role.
AWS_PROFILE=land-valuation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# F03 AI assistant uses Bedrock in this AWS setup. For local Ollama testing set
# AI_PROVIDER=ollama. Native FastAPI uses OLLAMA_BASE_URL; Docker Compose maps
# OLLAMA_DOCKER_BASE_URL into the API container instead.
AI_PROVIDER=bedrock
AI_PROMPT_VERSION=f03-v1
AI_FIELD_ANALYSIS_PROMPT_VERSION=field-analysis-v1
AI_CODEX_IMPORT_PROMPT_VERSION=codex-field-analysis-v1
AI_RULE_EXTRACTION_PROMPT_VERSION=rule-pack-extraction-v1
AI_FIELD_ANALYSIS_MAX_CHARS=40000
AI_FIELD_ANALYSIS_MAX_CANDIDATES=30
AI_TIMEOUT_SECONDS=30
AI_MAX_TOOL_ROUNDS=5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_TIMEOUT_SECONDS=120
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional second-pass model for low-confidence or rule-conflict fields.
# Recommended IDs: global.anthropic.claude-sonnet-4-5-20250929-v1:0 and global.anthropic.claude-opus-4-6-v1.
# Recommended routing: Sonnet 4.5 primary, Opus 4.6 fallback.
BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-opus-4-6-v1
BEDROCK_FALLBACK_CONFIDENCE_THRESHOLD=0.85
GEMINI_API_KEY=

# Address lookup uses AWS Location Service. Map images and walking routes use Mapbox.
AWS_LOCATION_REGION=ap-northeast-1
AWS_LOCATION_PLACE_INDEX_NAME=spacey_place_index
AWS_LOCATION_LANGUAGE=zh-TW
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
MAPBOX_USERNAME=marcuslui8
MAPBOX_STYLE_ID=cmtz7vdme00a001ss8mxyf5kl
MAPBOX_STATIC_ZOOM=16
MAPBOX_IMAGE_WIDTH=1280
MAPBOX_IMAGE_HEIGHT=800
MAPBOX_TIMEOUT_SECONDS=20
