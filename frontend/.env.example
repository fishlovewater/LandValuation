VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK_API=false

# Playwright persistent Demo inputs. Keep these empty in the tracked example;
# provide values only through the local shell/CI secret store.
E2E_APPRAISER_USERNAME=
E2E_APPRAISER_PASSWORD=
E2E_REVIEWER_USERNAME=
E2E_REVIEWER_PASSWORD=
E2E_INSPECTOR_USERNAME=
E2E_INSPECTOR_PASSWORD=
E2E_CASE_ID=
E2E_CASE_NO=
E2E_F03_FORM_ID=

# Keep the local provider boundary truthful: evidence_only expects the fixed
# safe refusal with zero Assistant citations. Set codex_cli or bedrock only
# when that real provider is configured outside tracked files.
KNOWLEDGE_ANSWER_PROVIDER=evidence_only

# Permission acceptance gate. Keep disabled and empty until an approved,
# development-only operator command exists for the same persistent user. The
# command must be the documented isolated Compose wrapper with action/code
# shell variables. It is resolved from frontend/; --project-directory and all
# input files are fixed so the command cannot be redirected to another stack:
# docker compose --project-directory .. -p landvaluation-persistent-demo -f ../docker-compose.yml -f ../docker-compose.demo.yml --env-file ../.env.example exec -T api python -m app.demo permission %E2E_PERMISSION_ACTION% %E2E_PERMISSION_CODE%
E2E_PERMISSION_GATE_ENABLED=false
E2E_PERMISSION_CODE=
E2E_PERMISSION_OPERATOR_COMMAND=docker compose --project-directory .. -p landvaluation-persistent-demo -f ../docker-compose.yml -f ../docker-compose.demo.yml --env-file ../.env.example exec -T api python -m app.demo permission %E2E_PERMISSION_ACTION% %E2E_PERMISSION_CODE%
